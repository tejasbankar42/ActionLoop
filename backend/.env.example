# Copy to backend/.env. Never commit the real file.

# --- Core ---
JWT_SECRET=replace-with-a-long-random-string
# PostgreSQL (Docker sets this automatically). Leave unset for local SQLite.
# DATABASE_URL=postgresql+psycopg://actionloop:actionloop-dev@localhost:5432/actionloop
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=10
SEED_ON_STARTUP=true

# --- AI (leave empty for DEMO MODE: deterministic parsers, no paid API) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LOW_CONFIDENCE_THRESHOLD=0.75
# Visual pacing between agent steps in demo mode (ms). 0 = as fast as possible.
DEMO_STEP_DELAY_MS=600

# --- MST Blockchain ---
# testnet (chain 91562037) or mainnet (chain 4646)
MST_NETWORK=testnet
# Optional overrides (defaults come from the official MST docs)
MST_RPC_URL=
MST_CHAIN_ID=
MST_EXPLORER_URL=
# Deployed ActionLoopAuditRegistry address. If empty, read from contracts/deployments/<network>.json
AUDIT_REGISTRY_ADDRESS=
# Backend relayer key used for automatic anchoring (an authorized submitter). TESTNET key only.
MST_RELAYER_PRIVATE_KEY=
BLOCKCHAIN_AUTO_ANCHOR=true
ANCHOR_EVENT_TYPES=APPROVAL_DECISION,WORKFLOW_COMPLETED,WORKFLOW_REJECTED,VALIDATION_BLOCKED
